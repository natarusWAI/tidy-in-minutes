---
import { SITE_NAME } from '../config';
const base = import.meta.env.BASE_URL;
---
<footer>
  <p class="muted">
    Some links on this site are affiliate links. <a href={`${base}affiliate-disclosure/`}>Read our disclosure</a>.
  </p>
  <p class="muted">
    © {new Date().getFullYear()} {SITE_NAME} ·
    <a href={`${base}privacy-policy/`}>Privacy Policy</a> ·
    <a href={`${base}affiliate-disclosure/`}>Affiliate Disclosure</a>
  </p>
</footer>
<style>
  footer { max-width: 760px; margin: 2rem auto 0; padding: 1rem 1.25rem 2rem; border-top: 1px solid #e4e1d8; }
</style>
