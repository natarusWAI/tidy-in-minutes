---
import { SITE_NAME } from '../config';
const base = import.meta.env.BASE_URL;
const links = [
  { href: base, label: 'Home' },
  { href: `${base}blog/`, label: 'Blog' },
  { href: `${base}products/`, label: 'Products' },
];
---
<header>
  <a class="brand" href={base}>{SITE_NAME}</a>
  <nav>
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
  </nav>
</header>
<style>
  header { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: .5rem; max-width: 760px; margin: 0 auto; padding: 1rem 1.25rem; border-bottom: 1px solid #e4e1d8; }
  .brand { font-weight: 700; font-size: 1.2rem; text-decoration: none; color: var(--ink); }
  nav { display: flex; gap: 1.1rem; }
  nav a { text-decoration: none; }
</style>
